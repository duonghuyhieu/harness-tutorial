{
  "version": 1,
  "project": "harness-tutorial",
  "entry_file": "AGENTS.md",
  "progress_file": "PROGRESS.md",
  "feature_list": "feature_list.json",
  "rules_file": ".harness/rules.json",
  "max_entry_lines": 200,
  "step_timeout_sec": 1800,
  "commands": {
    "setup": [],
    "dev": [],
    "smoke": [
      {
        "cmd": "python tests/check_site.py --smoke",
        "cwd": "."
      }
    ],
    "lint": [
      {
        "cmd": "python -m py_compile tests/check_site.py",
        "cwd": "."
      }
    ],
    "typecheck": [],
    "test": [
      {
        "cmd": "python tests/check_site.py",
        "cwd": "."
      }
    ],
    "build": [],
    "e2e": [
      {
        "cmd": "python tests/check_site.py --strict",
        "cwd": "."
      }
    ]
  },
  "check": [
    "rules",
    "docs",
    "lint",
    "typecheck",
    "test"
  ],
  "full_check": [
    "rules",
    "docs",
    "lint",
    "typecheck",
    "test",
    "build",
    "e2e",
    "regression"
  ],
  "debug_patterns": {
    "error": [
      "\\bconsole\\.log\\(",
      "^\\s*debugger;?\\s*$",
      "\\bbreakpoint\\(\\)",
      "pdb\\.set_trace\\(",
      "^\\s*import pdb",
      "binding\\.pry",
      "\\bvar_dump\\(",
      "\\bdd\\("
    ],
    "warn": [
      "System\\.out\\.println\\(",
      "\\bTODO\\b",
      "\\bFIXME\\b",
      "\\bHACK\\b"
    ]
  },
  "stale_artifacts": [
    "*.tmp",
    "*.bak",
    "*.swp",
    "*~",
    "*.orig",
    "*.rej",
    "scratch.*",
    "debug.*",
    "temp.*",
    "WIP.md",
    "IN_PROGRESS.md",
    "test-manual.*"
  ],
  "verify_check": "quick",
  "scope_drift": "warn",
  "scope_exempt": [
    ".claude/*",
    ".harness/*",
    "AGENTS.md",
    "CLAUDE.md",
    "PROGRESS.md",
    "docs/*",
    "feature_list.json",
    "init.ps1",
    "init.sh",
    "scripts/harness.py"
  ],
  "max_hard_constraints": 15,
  "debug_exempt": [],
  "scope_guard": "ask",
  "activity_max_lines": 2000,
  "harness_version": "2.0.0"
}
